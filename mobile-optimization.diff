@@ -0,0 +1,60 @@
+'use server'
+
+import logger from '@/lib/logger'
+
+export type SubFund = {
+  id: string
+  name: string
+}
+
+export type Fund = {
+  id: string
+  name: string
+  subfunds: SubFund[]
+}
+
+/**
+ * Get funds with their subfunds
+ * TODO: Replace static data with API call when backend endpoint is ready
+ * @returns Promise resolving to array of funds with subfunds
+ */
+export async function getFunds(): Promise<Fund[]> {
+  try {
+    logger.info('Getting funds with subfunds')
+
+    // Static JSON data - will be replaced with API call
+    const staticFunds: Fund[] = [
+      {
+        id: '1',
+        name: 'Fund a',
+        subfunds: [
+          {
+            id: '1',
+            name: 'Subfund a',
+          },
+        ],
+      },
+      {
+        id: '2',
+        name: 'Fund b',
+        subfunds: [
+          {
+            id: '2',
+            name: 'Subfund b',
+          },
+        ],
+      },
+    ]
+
+    logger.info(
+      { fundCount: staticFunds.length },
+      'Successfully fetched funds'
+    )
+
+    return staticFunds
+  } catch (error) {
+    logger.error({ error }, 'Error in getFunds')
+    throw error
+  }
+}
+
