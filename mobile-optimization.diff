@@ -0,0 +1,57 @@
+import { type ChartDataPoint, type ChartLineConfig } from './chart-utils'
+import { getDefaultChartColors } from './chart-utils'
+
+export function generateTestChartData(
+  dateRange: { start: string; end: string },
+  numberOfPoints: number = 12
+): ChartDataPoint[] {
+  const startDate = new Date(dateRange.start)
+  const endDate = new Date(dateRange.end)
+  const timeDiff = endDate.getTime() - startDate.getTime()
+  const interval = timeDiff / (numberOfPoints - 1)
+
+  const data: ChartDataPoint[] = []
+
+  for (let i = 0; i < numberOfPoints; i++) {
+    const date = new Date(startDate.getTime() + interval * i)
+    const dateStr = date.toISOString().split('T')[0]
+
+    data.push({
+      date: dateStr,
+      line1: Math.floor(Math.random() * 100) + 50,
+      line2: Math.floor(Math.random() * 100) + 100,
+      line3: Math.floor(Math.random() * 100) + 75,
+      line4: Math.floor(Math.random() * 100) + 125,
+    })
+  }
+
+  return data
+}
+
+export function getTestChartLines(): ChartLineConfig[] {
+  const colors = getDefaultChartColors()
+
+  return [
+    {
+      dataKey: 'line1',
+      label: 'Series A',
+      color: colors[0] || '#3b82f6',
+    },
+    {
+      dataKey: 'line2',
+      label: 'Series B',
+      color: colors[1] || '#10b981',
+    },
+    {
+      dataKey: 'line3',
+      label: 'Series C',
+      color: colors[2] || '#ef4444',
+    },
+    {
+      dataKey: 'line4',
+      label: 'Series D',
+      color: colors[3] || '#8b5cf6',
+    },
+  ]
+}
+
