+'use client'
+
+import * as React from 'react'
+
+import { cn } from '@/lib/utils'
+import { type ChartConfig } from '@/lib/chart-utils'
+
+type ChartLegendProps = {
+  config: ChartConfig
+  visibleLines: Set<string>
+  onLineToggle: (dataKey: string) => void
+  className?: string
+}
+
+export function ChartLegend({
+  config,
+  visibleLines,
+  onLineToggle,
+  className,
+}: ChartLegendProps) {
+  const handleClick = React.useCallback(
+    (dataKey: string) => {
+      onLineToggle(dataKey)
+    },
+    [onLineToggle]
+  )
+
+  return (
+    <div
+      className={cn(
+        'flex flex-wrap items-center justify-center pt-2',
+        className
+      )}
+    >
+      {Object.entries(config).map(([dataKey, lineConfig]) => {
+        const isVisible = visibleLines.has(dataKey)
+
+        return (
+          <button
+            key={dataKey}
+            type="button"
+            onClick={() => handleClick(dataKey)}
+            className={cn(
+              'flex items-center gap-2 rounded-md px-3 py-1.5 text-sm transition-colors hover:bg-neutral-100',
+              !isVisible && 'opacity-50'
+            )}
+            aria-label={`Toggle ${lineConfig.label} visibility`}
+          >
+            <div
+              className="h-3 w-3 shrink-0 rounded-full"
+              style={{
+                backgroundColor: lineConfig.color,
+              }}
+            />
+            <span className={cn(!isVisible && 'line-through')}>
+              {lineConfig.label}
+            </span>
+          </button>
+        )
+      })}
+    </div>
+  )
+}
+
+export type { ChartLegendProps }
+
