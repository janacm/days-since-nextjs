@@ -0,0 +1,117 @@
+'use client'
+
+import * as React from 'react'
+import { Area, AreaChart, CartesianGrid, XAxis, YAxis } from 'recharts'
+
+import {
+  ChartContainer,
+  ChartTooltip,
+  ChartTooltipContent,
+} from '@/components/ui/chart'
+import { type ChartConfig, type ChartDataPoint } from '@/lib/chart-utils'
+
+type LineAreaChartProps = {
+  data: ChartDataPoint[]
+  config: ChartConfig
+  height?: number
+  xAxisKey: string
+  className?: string
+  visibleLines?: Set<string>
+  onLineVisibilityChange?: (dataKey: string, visible: boolean) => void
+}
+
+export function LineAreaChart({
+  data,
+  config,
+  height = 300,
+  xAxisKey,
+  className,
+  visibleLines,
+  onLineVisibilityChange,
+}: LineAreaChartProps) {
+  const [internalVisibleLines, setInternalVisibleLines] = React.useState<
+    Set<string>
+  >(new Set(Object.keys(config)))
+
+  const activeVisibleLines =
+    visibleLines !== undefined ? visibleLines : internalVisibleLines
+
+  const handleLineToggle = React.useCallback(
+    (dataKey: string) => {
+      const newVisible = new Set(activeVisibleLines)
+      if (newVisible.has(dataKey)) {
+        newVisible.delete(dataKey)
+      } else {
+        newVisible.add(dataKey)
+      }
+
+      if (visibleLines === undefined) {
+        setInternalVisibleLines(newVisible)
+      }
+
+      if (onLineVisibilityChange) {
+        onLineVisibilityChange(dataKey, newVisible.has(dataKey))
+      }
+    },
+    [activeVisibleLines, visibleLines, onLineVisibilityChange]
+  )
+
+  const chartDataWithConfig = React.useMemo(() => {
+    return data.map((point) => ({
+      ...point,
+      chartConfig: config,
+    }))
+  }, [data, config])
+
+  const visibleDataKeys = React.useMemo(() => {
+    return Object.keys(config).filter((key) => activeVisibleLines.has(key))
+  }, [config, activeVisibleLines])
+
+  return (
+    <ChartContainer config={config} className={className} style={{ height }}>
+      <AreaChart
+        data={chartDataWithConfig}
+        margin={{ top: 10, right: 10, left: 0, bottom: 0 }}
+      >
+        <CartesianGrid strokeDasharray="3 3" className="stroke-muted" />
+        <XAxis
+          dataKey={xAxisKey}
+          tickLine={false}
+          axisLine={false}
+          tickMargin={8}
+          className="text-xs"
+        />
+        <YAxis
+          tickLine={false}
+          axisLine={false}
+          tickMargin={8}
+          className="text-xs"
+        />
+        <ChartTooltip
+          cursor={false}
+          content={<ChartTooltipContent indicator="dot" />}
+        />
+        {visibleDataKeys.map((dataKey) => {
+          const lineConfig = config[dataKey]
+          if (!lineConfig) return null
+
+          return (
+            <Area
+              key={dataKey}
+              type="monotone"
+              dataKey={dataKey}
+              stroke={lineConfig.color}
+              fill={lineConfig.color}
+              fillOpacity={0.2}
+              strokeWidth={2}
+              hide={!activeVisibleLines.has(dataKey)}
+            />
+          )
+        })}
+      </AreaChart>
+    </ChartContainer>
+  )
+}
+
+export type { LineAreaChartProps }
+
