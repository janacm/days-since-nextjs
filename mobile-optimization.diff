+'use client'
+
+import type { ColumnDef } from '@tanstack/react-table'
+import dayjs from 'dayjs'
+
+import { CompanyLogo } from '@/components/company-logo'
+
+export type SelectedCompany = {
+  id: string
+  name: string
+  domain?: string
+  logoUrl?: string | null
+  cost: number // in millions
+  date: string // ISO date string
+}
+
+const formatCost = (value: number) => {
+  return `$${value.toFixed(1)}M`
+}
+
+export const selectedCompaniesColumns: ColumnDef<SelectedCompany>[] = [
+  {
+    id: 'icon',
+    header: '',
+    cell: ({ row }) => {
+      const company = row.original
+      return (
+        <CompanyLogo
+          domain={company.domain}
+          fallbackUrl={company.logoUrl}
+          name={company.name}
+          size={32}
+        />
+      )
+    },
+    enableSorting: false,
+  },
+  {
+    accessorKey: 'name',
+    header: 'Company',
+    cell: ({ getValue }) => {
+      return <span className="table-cell-text">{getValue() as string}</span>
+    },
+  },
+  {
+    accessorKey: 'cost',
+    header: 'Cost ($M)',
+    cell: ({ getValue }) => {
+      const cost = getValue() as number
+      return <span className="table-cell-text">{formatCost(cost)}</span>
+    },
+  },
+  {
+    accessorKey: 'date',
+    header: 'Date',
+    cell: ({ getValue }) => {
+      const date = getValue() as string
+      return (
+        <span className="table-cell-text">
+          {dayjs(date).format('MMM D, YYYY')}
+        </span>
+      )
+    },
+  },
+]
+
diff --git a/src/app/(app)/dashboard/pacing/page.tsx b/src/app/(app)/dashboard/pacing/page.tsx
new file mode 100644
index 0000000..20146a8
--- /dev/null
+++ b/src/app/(app)/dashboard/pacing/page.tsx
@@ -0,0 +1,165 @@
+'use client'
+
+import { useEffect, useState } from 'react'
+
+import { getFunds, type Fund } from '@/actions/pacing/getFunds'
+import { MenuButton } from '@/components/menu-button'
+import { PerformanceChart } from '@/components/charts/performance-chart'
+import { PageHeader } from '@/components/page-header'
+import { Separator } from '@/components/ui/separator'
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from '@/components/ui/select'
+import {
+  generateTestChartData,
+  getTestChartLines,
+} from '@/lib/test-chart-data'
+
+import { SectionCard } from '@/components/section-card'
+
+import { FundSelect } from './_components/FundSelect'
+import { FundDetails } from './_components/FundDetails'
+import { SelectedCompanies } from './_components/SelectedCompanies'
+
+const FUND_START_OPTIONS = [
+  { value: '2024-fund-start', label: '2024 - Fund Start' },
+  { value: '2023-fund-start', label: '2023 - Fund Start' },
+  { value: '2022-fund-start', label: '2022 - Fund Start' },
+  { value: '2021-fund-start', label: '2021 - Fund Start' },
+]
+
+export default function PacingPage() {
+  const [funds, setFunds] = useState<Fund[]>([])
+  const [selectedFund, setSelectedFund] = useState('')
+  const [selectedSubFund, setSelectedSubFund] = useState('')
+  const [selectedFundStart, setSelectedFundStart] = useState(
+    '2024-fund-start'
+  )
+
+  useEffect(() => {
+    const loadFunds = async () => {
+      try {
+        const fundsData = await getFunds()
+        setFunds(fundsData)
+      } catch (error) {
+        console.error('Failed to load funds:', error)
+      }
+    }
+
+    loadFunds()
+  }, [])
+
+  const selectedFundData = funds.find((fund) => fund.id === selectedFund)
+  const subfundOptions =
+    selectedFundData?.subfunds.map((subfund) => ({
+      value: subfund.id,
+      label: subfund.name,
+    })) || []
+
+  const fundOptions = funds.map((fund) => ({
+    value: fund.id,
+    label: fund.name,
+  }))
+
+  const handleFundChange = (fundId: string) => {
+    setSelectedFund(fundId)
+    setSelectedSubFund('')
+  }
+
+  const chartData = generateTestChartData({
+    start: '2024-01-01',
+    end: '2024-12-31',
+  })
+  const chartLines = getTestChartLines()
+
+  return (
+    <div className="flex h-full w-full flex-col">
+      <PageHeader title="Pacing" action={<MenuButton />} />
+
+      {/* Content */}
+      <div className="grow overflow-auto bg-neutral-50 px-4 py-8 md:px-10">
+        <div className="max-w-6xl">
+          {/* Dropdowns */}
+          <div className="mb-8 flex flex-col gap-4 md:flex-row md:items-center md:gap-6">
+            <FundSelect
+              label="Fund Selection"
+              value={selectedFund}
+              onValueChange={handleFundChange}
+              options={fundOptions}
+              placeholder="Select a fund"
+            />
+            <Separator
+              orientation="horizontal"
+              className="md:hidden"
+            />
+            <Separator
+              orientation="vertical"
+              className="hidden md:block"
+            />
+            <FundSelect
+              label="SubFund Selection"
+              value={selectedSubFund}
+              onValueChange={setSelectedSubFund}
+              options={subfundOptions}
+              placeholder={
+                selectedFund ? 'Select a subfund' : 'Select a fund first'
+              }
+              disabled={!selectedFund}
+            />
+          </div>
+
+          {/* Fund Details */}
+          <SectionCard header="SubFund" subHeader="As of October 20, 2025">
+            <FundDetails />
+          </SectionCard>
+
+          
+
+          {/* Chart */}
+          <SectionCard
+            header="Total Remaining"
+            subHeader={
+              <Select
+                value={selectedFundStart}
+                onValueChange={setSelectedFundStart}
+              >
+                <SelectTrigger className="w-fit">
+                  <SelectValue />
+                </SelectTrigger>
+                <SelectContent>
+                  {FUND_START_OPTIONS.map((option) => (
+                    <SelectItem key={option.value} value={option.value}>
+                      {option.label}
+                    </SelectItem>
+                  ))}
+                </SelectContent>
+              </Select>
+            }
+            className="mt-8"
+            cardClassName="pt-2 pb-2"
+            spacing="sm"
+          >
+            <div className="w-full overflow-hidden">
+              <PerformanceChart
+                data={chartData}
+                lines={chartLines}
+                xAxisKey="date"
+                height={350}
+              />
+            </div>
+          </SectionCard>
+
+          {/* Selected Companies */}
+          <SectionCard header="Selected Companies" className="mt-8">
+            <SelectedCompanies />
+          </SectionCard>
+        </div>
+      </div>
+    </div>
+  )
+}
+
