+export type ChartDataPoint = Record<string, string | number>
+
+export type ChartConfig = Record<
+  string,
+  {
+    label: string
+    color: string
+  }
+>
+
+export type ChartLineConfig = {
+  dataKey: string
+  label: string
+  color: string
+}
+
+export function createChartConfig(
+  lines: ChartLineConfig[]
+): ChartConfig {
+  return lines.reduce(
+    (acc, line) => {
+      acc[line.dataKey] = {
+        label: line.label,
+        color: line.color,
+      }
+      return acc
+    },
+    {} as ChartConfig
+  )
+}
+
+export function getDefaultChartColors(): string[] {
