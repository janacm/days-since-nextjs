+import { describe, expect, it } from 'vitest'
+
+import {
+  createChartConfig,
+  getDefaultChartColors,
+  type ChartLineConfig,
+} from '@/lib/chart-utils'
+
+describe('chart-utils', () => {
+  describe('getDefaultChartColors', () => {
+    it('returns an array of 4 color strings', () => {
+      const colors = getDefaultChartColors()
+      expect(colors).toHaveLength(4)
+      expect(colors.every((color) => typeof color === 'string')).toBe(true)
+    })
+
+    it('returns HSL color values', () => {
+      const colors = getDefaultChartColors()
+      colors.forEach((color) => {
+        expect(color).toMatch(/^hsl\(/)
+      })
+    })
+
+    it('returns consistent colors', () => {
+      const colors1 = getDefaultChartColors()
+      const colors2 = getDefaultChartColors()
+      expect(colors1).toEqual(colors2)
+    })
+  })
+
+  describe('createChartConfig', () => {
+    it('creates config from chart lines', () => {
+      const lines: ChartLineConfig[] = [
+        {
+          dataKey: 'line1',
+          label: 'Series A',
+          color: '#3b82f6',
+        },
+        {
+          dataKey: 'line2',
+          label: 'Series B',
+          color: '#10b981',
+        },
+      ]
+
+      const config = createChartConfig(lines)
+
+      expect(config).toEqual({
+        line1: {
+          label: 'Series A',
+          color: '#3b82f6',
+        },
+        line2: {
+          label: 'Series B',
+          color: '#10b981',
+        },
+      })
+    })
+
+    it('handles empty array', () => {
+      const config = createChartConfig([])
+      expect(config).toEqual({})
+    })
+
+    it('handles single line', () => {
+      const lines: ChartLineConfig[] = [
+        {
+          dataKey: 'single',
+          label: 'Single Line',
+          color: '#ef4444',
+        },
+      ]
+
+      const config = createChartConfig(lines)
+
+      expect(config).toEqual({
+        single: {
+          label: 'Single Line',
+          color: '#ef4444',
+        },
+      })
+    })
+
+    it('handles multiple lines with same dataKey', () => {
+      const lines: ChartLineConfig[] = [
+        {
+          dataKey: 'line1',
+          label: 'First',
+          color: '#3b82f6',
+        },
+        {
+          dataKey: 'line1',
+          label: 'Second',
+          color: '#10b981',
+        },
+      ]
+
+      const config = createChartConfig(lines)
+
+      expect(config.line1.label).toBe('Second')
+      expect(config.line1.color).toBe('#10b981')
+    })
+
+    it('preserves all properties correctly', () => {
+      const lines: ChartLineConfig[] = [
+        {
+          dataKey: 'test',
+          label: 'Test Label',
+          color: 'hsl(221.2 83.2% 53.3%)',
+        },
+      ]
+
+      const config = createChartConfig(lines)
+
+      expect(config.test.label).toBe('Test Label')
+      expect(config.test.color).toBe('hsl(221.2 83.2% 53.3%)')
+    })
+  })
+})
+
