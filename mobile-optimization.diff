@@ -0,0 +1,74 @@
+'use client'
+
+import * as React from 'react'
+
+import { ChartLegend } from '@/components/charts/chart-legend'
+import { LineChartComponent } from '@/components/charts/line-chart'
+import {
+  createChartConfig,
+  getDefaultChartColors,
+  type ChartDataPoint,
+  type ChartLineConfig,
+} from '@/lib/chart-utils'
+
+type PerformanceChartProps = {
+  data: ChartDataPoint[]
+  lines: ChartLineConfig[]
+  xAxisKey: string
+  height?: number
+  className?: string
+}
+
+export function PerformanceChart({
+  data,
+  lines,
+  xAxisKey,
+  height = 300,
+  className,
+}: PerformanceChartProps) {
+  const [visibleLines, setVisibleLines] = React.useState<Set<string>>(
+    new Set(lines.map((line) => line.dataKey))
+  )
+
+  const config = React.useMemo(() => createChartConfig(lines), [lines])
+
+  const handleLineToggle = React.useCallback(
+    (dataKey: string, visible: boolean) => {
+      setVisibleLines((prev) => {
+        const next = new Set(prev)
+        if (visible) {
+          next.add(dataKey)
+        } else {
+          next.delete(dataKey)
+        }
+        return next
+      })
+    },
+    []
+  )
+
+  return (
+    <div className={className}>
+      <LineChartComponent
+        data={data}
+        config={config}
+        xAxisKey={xAxisKey}
+        height={height}
+        visibleLines={visibleLines}
+        onLineVisibilityChange={handleLineToggle}
+      />
+      <ChartLegend
+        config={config}
+        visibleLines={visibleLines}
+        onLineToggle={(dataKey) => {
+          const isVisible = visibleLines.has(dataKey)
+          handleLineToggle(dataKey, !isVisible)
+        }}
+      />
+    </div>
+  )
+}
+
+export { getDefaultChartColors }
+export type { PerformanceChartProps }
+
