diff --git a/src/app/(app)/dashboard/pacing/_components/FundDetails.tsx b/src/app/(app)/dashboard/pacing/_components/FundDetails.tsx
new file mode 100644
index 0000000..f8ec55c
--- /dev/null
+++ b/src/app/(app)/dashboard/pacing/_components/FundDetails.tsx
@@ -0,0 +1,124 @@
+'use client'
+
+import { ChevronDownIcon } from 'lucide-react'
+import { useState } from 'react'
+
+import { Separator } from '@/components/ui/separator'
+import { cn } from '@/lib/utils'
+
+type FundDetailRow = {
+  label: string
+  value: string
+  isCollapsible?: boolean
+  subItems?: FundDetailRow[]
+}
+
+const FUND_DETAILS: FundDetailRow[] = [
+  { label: 'Fund Size', value: '$2,000.3 M' },
+  { label: 'Fees', value: '-$150.5 M' },
+  { label: 'Total Investable', value: '$175.0 M' },
+  {
+    label: 'Pipeline New',
+    value: '$50.0 M',
+    isCollapsible: true,
+    subItems: [],
+  },
+  {
+    label: 'Pipeline FO',
+    value: '$50.0 M',
+    isCollapsible: true,
+    subItems: [
+      { label: 'Company name 1', value: '$1.0 M' },
+      { label: 'Company name 2', value: '$1.0 M' },
+      { label: 'Company name 3', value: '$1.0 M' },
+    ],
+  },
+  { label: 'Remaining', value: '$88.0 M' },
+  { label: 'Recycled', value: '$93.3 M' },
+  { label: 'Pending Sale', value: '$53.4 M' },
+  { label: 'Total Remaining', value: '$260.5 M' },
+  { label: 'Available for New', value: '$56.0 M' },
+  { label: 'Available for Seed FO', value: '$67.4 M' },
+  { label: 'Available for Other FO', value: '$55.0 M' },
+]
+
+const SEPARATOR_AFTER_LABELS = ['Total Investable', 'Pending Sale']
+
+export function FundDetails() {
+  const [expandedSections, setExpandedSections] = useState<Set<string>>(
+    new Set()
+  )
+
+  const toggleSection = (label: string) => {
+    setExpandedSections((prev) => {
+      const next = new Set(prev)
+      if (next.has(label)) {
+        next.delete(label)
+      } else {
+        next.add(label)
+      }
+      return next
+    })
+  }
+
+  return (
+    <div className="space-y-3">
+      {FUND_DETAILS.map((detail) => {
+        const isExpanded = expandedSections.has(detail.label)
+        const hasSubItems =
+          detail.isCollapsible && detail.subItems && detail.subItems.length > 0
+
+        return (
+          <div key={detail.label}>
+            <div className="flex items-center justify-between">
+              <span className="text-sm text-neutral-600">
+                {detail.label}
+              </span>
+              <div className="flex items-center gap-2">
+                <span className="text-sm font-medium text-neutral-900">
+                  {detail.value}
+                </span>
+                {detail.isCollapsible && (
+                  <button
+                    type="button"
+                    onClick={() => toggleSection(detail.label)}
+                    className="flex items-center justify-center"
+                    aria-label={`Toggle ${detail.label}`}
+                  >
+                    <ChevronDownIcon
+                      className={cn(
+                        'size-4 text-neutral-500 transition-transform duration-200',
+                        isExpanded && 'rotate-180'
+                      )}
+                    />
+                  </button>
+                )}
+              </div>
+            </div>
+            {isExpanded && hasSubItems && (
+              <div className="ml-6 mt-2 space-y-2">
+                {detail.subItems?.map((subItem) => (
+                  <div
+                    key={subItem.label}
+                    className="flex items-center justify-between"
+                  >
+                    <span className="text-sm text-neutral-500">
+                      {subItem.label}
+                    </span>
+                    <span className="text-sm font-medium text-neutral-900">
+                      {subItem.value}
+                    </span>
+                  </div>
+                ))}
+              </div>
+            )}
+            {SEPARATOR_AFTER_LABELS.includes(detail.label) && (
+              <Separator className="mt-3" />
+            )}
+          </div>
+        )
+      })}
+    </div>
+  )
+}
+
diff --git a/src/app/(app)/dashboard/pacing/_components/FundSelect.tsx b/src/app/(app)/dashboard/pacing/_components/FundSelect.tsx
new file mode 100644
index 0000000..7c0ad89
--- /dev/null
+++ b/src/app/(app)/dashboard/pacing/_components/FundSelect.tsx
@@ -0,0 +1,45 @@
+'use client'
+
+import {
+  Select,
+  SelectContent,
+  SelectItem,
+  SelectTrigger,
+  SelectValue,
+} from '@/components/ui/select'
+
+type FundSelectProps = {
+  label: string
+  value: string
+  onValueChange: (value: string) => void
+  options: { value: string; label: string }[]
+  placeholder?: string
+  disabled?: boolean
+}
+
+export function FundSelect({
+  label,
+  value,
+  onValueChange,
+  options,
+  placeholder = 'Select...',
+  disabled = false,
+}: FundSelectProps) {
+  const selectId = label.toLowerCase().replace(/\s+/g, '-')
+
+  return (
+    <Select value={value || undefined} onValueChange={onValueChange} disabled={disabled}>
+      <SelectTrigger id={selectId} className="w-full">
+        <SelectValue placeholder={placeholder} />
+      </SelectTrigger>
+      <SelectContent>
+        {options.map((option) => (
+          <SelectItem key={option.value} value={option.value}>
+            {option.label}
+          </SelectItem>
+        ))}
+      </SelectContent>
+    </Select>
+  )
+}
+
