+import type { User } from '@/types/calendar'
+
+// Manual allowlist for dashboard defaulting
+const DASHBOARD_EMAIL_ALLOWLIST = new Set<string>([
+  'bpatel@generalcatalyst.com','rgupate@generalcatalyst.com','tsaaji@generalcatalyst.com','shoerning@generalcatalyst.com'
+])
+
+export function isDashboardEligible(profile: User | (Partial<User> & { email?: string; is_dashboard?: boolean }) | null): boolean {
+  if (!profile) return false
+
+  const email = profile.email || ''
+  const hasBackendFlag = Boolean((profile as { is_dashboard?: boolean }).is_dashboard)
+  const isAllowlisted = email.length > 0 && DASHBOARD_EMAIL_ALLOWLIST.has(email.toLowerCase())
+
+  return hasBackendFlag || isAllowlisted
+}
+
+export function getDefaultLandingPath(profile: User | (Partial<User> & { email?: string; is_dashboard?: boolean }) | null): '/dashboard/pacing' | '/meetings' {
+  return isDashboardEligible(profile) ? '/dashboard/pacing' : '/meetings'
+}
+
+
