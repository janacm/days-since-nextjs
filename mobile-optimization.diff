+import { render, screen } from '@testing-library/react'
+import userEvent from '@testing-library/user-event'
+import { describe, expect, it } from 'vitest'
+
+import { PerformanceChart } from '@/components/charts/performance-chart'
+import { type ChartDataPoint, type ChartLineConfig } from '@/lib/chart-utils'
+
+const mockChartData: ChartDataPoint[] = [
+  { date: '2024-01-01', line1: 50, line2: 100, line3: 75, line4: 125 },
+  { date: '2024-02-01', line1: 60, line2: 110, line3: 85, line4: 135 },
+  { date: '2024-03-01', line1: 70, line2: 120, line3: 95, line4: 145 },
+]
+
+const mockChartLines: ChartLineConfig[] = [
+  {
+    dataKey: 'line1',
+    label: 'Series A',
+    color: '#3b82f6',
+  },
+  {
+    dataKey: 'line2',
+    label: 'Series B',
+    color: '#10b981',
+  },
+  {
+    dataKey: 'line3',
+    label: 'Series C',
+    color: '#ef4444',
+  },
+  {
+    dataKey: 'line4',
+    label: 'Series D',
+    color: '#8b5cf6',
+  },
+]
+
+describe('PerformanceChart', () => {
+  const defaultProps = {
+    data: mockChartData,
+    lines: mockChartLines,
+    xAxisKey: 'date',
+  }
+
+  it('renders chart container', () => {
+    const { container } = render(<PerformanceChart {...defaultProps} />)
+
+    const chartContainer = container.querySelector('[data-chart]')
+    expect(chartContainer).toBeInTheDocument()
+  })
+
+  it('renders all legend items', () => {
+    render(<PerformanceChart {...defaultProps} />)
+
+    expect(screen.getByText('Series A')).toBeInTheDocument()
+    expect(screen.getByText('Series B')).toBeInTheDocument()
+    expect(screen.getByText('Series C')).toBeInTheDocument()
+    expect(screen.getByText('Series D')).toBeInTheDocument()
+  })
+
+  it('initializes with all lines visible', () => {
+    render(<PerformanceChart {...defaultProps} />)
+
+    const legendItems = screen.getAllByRole('button')
+    legendItems.forEach((item) => {
+      expect(item).not.toHaveClass('opacity-50')
+    })
+  })
+
+  it('toggles line visibility when legend item is clicked', async () => {
+    const user = userEvent.setup()
+    render(<PerformanceChart {...defaultProps} />)
+
+    const seriesAButton = screen.getByRole('button', {
+      name: /toggle series a visibility/i,
+    })
+
+    await user.click(seriesAButton)
+
+    expect(seriesAButton).toHaveClass('opacity-50')
+  })
+
+  it('can toggle multiple lines', async () => {
+    const user = userEvent.setup()
+    render(<PerformanceChart {...defaultProps} />)
+
+    const seriesAButton = screen.getByRole('button', {
+      name: /toggle series a visibility/i,
+    })
+    const seriesBButton = screen.getByRole('button', {
+      name: /toggle series b visibility/i,
+    })
+
+    await user.click(seriesAButton)
+    await user.click(seriesBButton)
+
+    expect(seriesAButton).toHaveClass('opacity-50')
+    expect(seriesBButton).toHaveClass('opacity-50')
+  })
+
+  it('can re-toggle a hidden line to make it visible', async () => {
+    const user = userEvent.setup()
+    render(<PerformanceChart {...defaultProps} />)
+
+    const seriesAButton = screen.getByRole('button', {
+      name: /toggle series a visibility/i,
+    })
+
+    await user.click(seriesAButton)
+    expect(seriesAButton).toHaveClass('opacity-50')
+
+    await user.click(seriesAButton)
+    expect(seriesAButton).not.toHaveClass('opacity-50')
+  })
+
+  it('applies custom height', () => {
+    const { container } = render(
+      <PerformanceChart {...defaultProps} height={500} />
+    )
+
+    const chartContainer = container.querySelector('[data-chart]')
+    expect(chartContainer).toBeInTheDocument()
+    expect(chartContainer).toHaveStyle({ height: '500px' })
+  })
+
+  it('uses default height when not provided', () => {
+    const { container } = render(<PerformanceChart {...defaultProps} />)
+
+    const chartContainer = container.querySelector('[data-chart]')
+    expect(chartContainer).toBeInTheDocument()
+  })
+
+  it('applies custom className', () => {
+    const { container } = render(
+      <PerformanceChart {...defaultProps} className="custom-class" />
+    )
+
+    const wrapper = container.firstChild as HTMLElement
+    expect(wrapper).toHaveClass('custom-class')
+  })
+
+  it('handles empty data array', () => {
+    render(<PerformanceChart {...defaultProps} data={[]} />)
+
+    expect(screen.getByText('Series A')).toBeInTheDocument()
+  })
+
+  it('handles single line', () => {
+    const singleLine = [mockChartLines[0]]
+
+    render(
+      <PerformanceChart
+        {...defaultProps}
+        lines={singleLine}
+      />
+    )
+
+    expect(screen.getByText('Series A')).toBeInTheDocument()
+    expect(screen.queryByText('Series B')).not.toBeInTheDocument()
+  })
+
+  it('handles data with different xAxisKey', () => {
+    const dataWithMonth = [
+      { month: 'Jan', line1: 50 },
+      { month: 'Feb', line1: 60 },
+    ]
+
+    render(
+      <PerformanceChart
+        data={dataWithMonth}
+        lines={[mockChartLines[0]]}
+        xAxisKey="month"
+      />
+    )
+
+    expect(screen.getByText('Series A')).toBeInTheDocument()
+  })
+})
+
