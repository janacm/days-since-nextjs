diff --git a/tests/unit/hooks/useMobileView.test.tsx b/tests/unit/hooks/useMobileView.test.tsx
new file mode 100644
index 0000000..ce665f0
--- /dev/null
+++ b/tests/unit/hooks/useMobileView.test.tsx
@@ -0,0 +1,107 @@
+import { act, renderHook } from '@testing-library/react'
+
+import { useMobileView } from '@/hooks/useMobileView'
+
+function installMatchMediaMock() {
+  const mm = (query: string) => {
+    const maxMatch = /max-width:\s*(\d+(?:\.\d+)?)px/.exec(query)
+    const minMatch = /min-width:\s*(\d+(?:\.\d+)?)px/.exec(query)
+    const max = maxMatch ? parseFloat(maxMatch[1]) : Infinity
+    const min = minMatch ? parseFloat(minMatch[1]) : -Infinity
+    const matches = window.innerWidth >= min && window.innerWidth <= max
+    return {
+      matches,
+      media: query,
+      onchange: null as unknown as ((this: MediaQueryList, ev: MediaQueryListEvent) => unknown) | null,
+      addEventListener: vi.fn(),
+      removeEventListener: vi.fn(),
+      addListener: vi.fn(), // deprecated but some libs still call these
+      removeListener: vi.fn(),
+      dispatchEvent: vi.fn(() => false),
+    } as unknown as MediaQueryList
+  }
+
+  Object.defineProperty(window, 'matchMedia', {
+    writable: true,
+    configurable: true,
+    value: vi.fn(mm),
+  })
+}
+
+function setViewportWidth(width: number) {
+  Object.defineProperty(window, 'innerWidth', { writable: true, configurable: true, value: width })
+  window.dispatchEvent(new Event('resize'))
+}
+
+describe('useMobileView', () => {
+  beforeEach(() => {
+    // Default to desktop width and install matchMedia stub
+    setViewportWidth(1024)
+    installMatchMediaMock()
+  })
+
+  afterEach(() => {
+    vi.resetAllMocks()
+  })
+
+  test('returns false on first render to avoid hydration mismatch', () => {
+    const { result } = renderHook(() => useMobileView())
+    expect(result.current).toBe(false)
+  })
+
+  test('reports true when width is below 768px after mount', async () => {
+    const { result } = renderHook(() => useMobileView())
+
+    // Switch to mobile and let effect update
+    await act(async () => {
+      setViewportWidth(500)
+      // allow effect to run
+    })
+
+    expect(result.current).toBe(true)
+  })
+
+  test('reports false when width is 768px or above', async () => {
+    const { result } = renderHook(() => useMobileView())
+
+    await act(async () => {
+      setViewportWidth(1200)
+    })
+
+    expect(result.current).toBe(false)
+  })
+
+  test('updates value on resize events', async () => {
+    const { result } = renderHook(() => useMobileView())
+
+    await act(async () => {
+      setViewportWidth(600)
+    })
+    expect(result.current).toBe(true)
+
+    await act(async () => {
+      setViewportWidth(900)
+    })
+    expect(result.current).toBe(false)
+  })
+
+  test('falls back to innerWidth when matchMedia is unavailable', async () => {
+    // Remove matchMedia
+    // @ts-expect-error testing removal
+    delete window.matchMedia
+
+    const { result } = renderHook(() => useMobileView())
+
+    await act(async () => {
+      setViewportWidth(700)
+    })
+    expect(result.current).toBe(true)
+
+    await act(async () => {
+      setViewportWidth(800)
+    })
+    expect(result.current).toBe(false)
+  })
+})
+
+
