+import { describe, expect, it, vi } from 'vitest'
+
+import { LineChartComponent } from '@/components/charts/line-chart'
+import { type ChartConfig, type ChartDataPoint } from '@/lib/chart-utils'
+
+const mockChartData: ChartDataPoint[] = [
+  { date: '2024-01-01', line1: 50, line2: 100 },
+  { date: '2024-02-01', line1: 60, line2: 110 },
+  { date: '2024-03-01', line1: 70, line2: 120 },
+]
+
+const mockConfig: ChartConfig = {
+  line1: {
+    label: 'Series A',
+    color: '#3b82f6',
+  },
+  line2: {
+    label: 'Series B',
+    color: '#10b981',
+  },
+}
+
+describe('LineChartComponent', () => {
+  const defaultProps = {
+    data: mockChartData,
+    config: mockConfig,
+    xAxisKey: 'date',
+  }
+
+  it('renders chart container', () => {
+    const { container } = render(<LineChartComponent {...defaultProps} />)
+
+    const chartContainer = container.querySelector('[data-chart]')
+    expect(chartContainer).toBeInTheDocument()
+  })
+
+  it('applies custom height', () => {
+    const { container } = render(
+      <LineChartComponent {...defaultProps} height={500} />
+    )
+
+    const chartContainer = container.querySelector('[data-chart]')
+    expect(chartContainer).toBeInTheDocument()
+    expect(chartContainer).toHaveStyle({ height: '500px' })
+  })
+
+  it('uses default height when not provided', () => {
+    const { container } = render(<LineChartComponent {...defaultProps} />)
+
+    const chartContainer = container.querySelector('[data-chart]')
+    expect(chartContainer).toBeInTheDocument()
+  })
+
+  it('applies custom className', () => {
+    const { container } = render(
+      <LineChartComponent {...defaultProps} className="custom-class" />
+    )
+
+    const chartContainer = container.querySelector('[data-chart]')
+    expect(chartContainer).toBeInTheDocument()
+    expect(chartContainer).toHaveClass('custom-class')
+  })
+
+  it('handles empty data array', () => {
+    const { container } = render(
+      <LineChartComponent
+        {...defaultProps}
+        data={[]}
+      />
+    )
+
+    const chartContainer = container.querySelector('[data-chart]')
+    expect(chartContainer).toBeInTheDocument()
+  })
+
+  it('handles empty config', () => {
+    const { container } = render(
+      <LineChartComponent
+        {...defaultProps}
+        config={{}}
+      />
+    )
+
+    const chartContainer = container.querySelector('[data-chart]')
+    expect(chartContainer).toBeInTheDocument()
+  })
+
+  it('respects visibleLines prop', () => {
+    const visibleLines = new Set(['line1'])
+
+    const { container } = render(
+      <LineChartComponent
+        {...defaultProps}
+        visibleLines={visibleLines}
+      />
+    )
+
+    const chartContainer = container.querySelector('[data-chart]')
+    expect(chartContainer).toBeInTheDocument()
+  })
+
+  it('accepts onLineVisibilityChange callback', () => {
+    const onLineVisibilityChange = vi.fn()
+    const visibleLines = new Set(['line1', 'line2'])
+
+    const { container } = render(
+      <LineChartComponent
+        {...defaultProps}
+        visibleLines={visibleLines}
+        onLineVisibilityChange={onLineVisibilityChange}
+      />
+    )
+
+    const chartContainer = container.querySelector('[data-chart]')
+    expect(chartContainer).toBeInTheDocument()
+  })
+
+  it('manages internal state when visibleLines is not provided', () => {
+    const { container } = render(
+      <LineChartComponent
+        {...defaultProps}
+        visibleLines={undefined}
+      />
+    )
+
+    const chartContainer = container.querySelector('[data-chart]')
+    expect(chartContainer).toBeInTheDocument()
+  })
+
+  it('handles data with different xAxisKey', () => {
+    const dataWithMonth = [
+      { month: 'Jan', line1: 50 },
+      { month: 'Feb', line1: 60 },
+    ]
+
+    const { container } = render(
+      <LineChartComponent
+        data={dataWithMonth}
+        config={mockConfig}
+        xAxisKey="month"
+      />
+    )
+
+    const chartContainer = container.querySelector('[data-chart]')
+    expect(chartContainer).toBeInTheDocument()
+  })
+
+  it('handles config with missing dataKey in data', () => {
+    const configWithExtra = {
+      ...mockConfig,
+      line3: {
+        label: 'Series C',
+        color: '#ef4444',
+      },
+    }
+
+    const { container } = render(
+      <LineChartComponent
+        {...defaultProps}
+        config={configWithExtra}
+      />
+    )
+
+    const chartContainer = container.querySelector('[data-chart]')
+    expect(chartContainer).toBeInTheDocument()
+  })
+})
+
