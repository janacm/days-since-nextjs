+import * as React from 'react'
+
+import { cn } from '@/lib/utils'
+
+type SectionCardProps = {
+  header: React.ReactNode
+  subHeader?: React.ReactNode
+  children: React.ReactNode
+  className?: string
+  headerClassName?: string
+  cardClassName?: string
+  spacing?: 'sm' | 'md' | 'lg'
+}
+
+export function SectionCard({
+  header,
+  subHeader,
+  children,
+  className,
+  headerClassName,
+  cardClassName,
+  spacing = 'md',
+}: SectionCardProps) {
+  const spacingClasses = {
+    sm: 'mb-2',
+    md: 'mb-2',
+    lg: 'mb-4',
+  }
+
+  const cardSpacingClasses = {
+    sm: 'p-2',
+    md: 'p-4',
+    lg: 'p-6',
+  }
+
+  const renderHeader = () => {
+    if (typeof header === 'string') {
+      return <h2 className="text-lg font-medium text-neutral-900">{header}</h2>
+    }
+    return header
+  }
+
+  const renderSubHeader = () => {
+    if (!subHeader) return null
+    if (typeof subHeader === 'string') {
+      return <p className="text-sm text-neutral-500">{subHeader}</p>
+    }
+    return subHeader
+  }
+
+  return (
+    <div className={className}>
+      <div
+        className={cn(
+          'flex items-center justify-between',
+          headerClassName,
+          spacingClasses[spacing]
+        )}
+      >
+        {renderHeader()}
+        {renderSubHeader()}
+      </div>
+      <div
+        className={cn(
+          'w-full overflow-hidden rounded-lg border border-neutral-200 bg-white',
+          cardSpacingClasses[spacing],
+          cardClassName
+        )}
+      >
+        {children}
+      </div>
+    </div>
+  )
+}
+
